---
import '../styles/global.css';
import Arrow from '../components/ui/Arrow.astro';
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const actual = Astro.url.pathname;
const site = import.meta.env.PUBLIC_SITE_URL;
const canonical = site ? new URL(actual, site).href : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#142824" />
    {actual.startsWith('/app') && (
      <meta name="robots" content="noindex, follow" />
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content="IntVal" />
    <meta property="og:title" content={title + ' | IntVal'} />
    <meta property="og:description" content={description} />
    {site && (
      <meta
        property="og:image"
        content={new URL('/images/social.png', site).href}
      />
    )}
    {canonical && <meta property="og:url" content={canonical} />}
    <title>{title} | IntVal</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">
      Saltar al contenido
    </a>
    <header class="site-header wrap">
      <a class="brand" href="/" aria-label="IntVal — Inicio">
        IntVal<span aria-hidden="true">.</span>
      </a>
      <nav aria-label="Principal">
        <ul>
          <li>
            <a href="/" aria-current={actual === '/' ? 'page' : undefined}>
              Inicio
            </a>
          </li>
          <li>
            <a href="/#como-funciona">Cómo funciona</a>
          </li>
          <li>
            <a
              href="/metodologia/"
              aria-current={actual === '/metodologia/' ? 'page' : undefined}
            >
              Metodología
            </a>
          </li>
          <li>
            <a
              href="/app/"
              aria-current={actual === '/app/' ? 'page' : undefined}
            >
              Aplicación
            </a>
          </li>
          <li>
            <a href="https://github.com/adndvlp/IntVal">
              GitHub <span aria-hidden="true">↗</span>
            </a>
          </li>
          <li>
            <a class="header-demo" href="/app/?fuente=demo">
              Explorar la demo
            </a>
          </li>
        </ul>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <a class="brand footer-brand" href="/" aria-label="IntVal — Inicio">
            IntVal<span aria-hidden="true">.</span>
          </a>
          <p>
            Más contexto para tus preguntas
            <br />
            sobre el valor de una empresa.
          </p>
        </div>
        <div class="footer-links">
          <a href="/metodologia/">
            Metodología <Arrow />
          </a>
          <a href="https://github.com/adndvlp/IntVal">
            Código en GitHub <Arrow />
          </a>
          <a href="https://github.com/adndvlp/IntVal/blob/main/LICENSE">
            Licencia MIT <Arrow />
          </a>
        </div>
        <div class="footer-bottom">
          <span>
            © 2026 <a href="https://github.com/adndvlp">adndvlp</a>
          </span>
          <p>
            Proyecto educativo. No constituye asesoría financiera ni una
            recomendación de inversión.
          </p>
          <span>Hecho para entender.</span>
        </div>
      </div>
    </footer>
  </body>
</html>
