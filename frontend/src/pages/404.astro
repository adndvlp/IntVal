---
import Base from '../layouts/Base.astro';
import Action from '../components/ui/Action.astro';
---

<Base
  title="Página no encontrada"
  description="Esta dirección no está disponible. Vuelve a la página principal de IntVal."
>
  <div class="wrap error-page">
    <p class="eyebrow">404 / Fuera de ruta</p>
    <h1 id="contenido" tabindex="-1">
      Esta página
      <br />
      no está aquí.
    </h1>
    <p class="intro">
      La dirección puede haber cambiado. Puedes volver al inicio o consultar la
      metodología.
    </p>
    <div class="actions">
      <Action href="/">Volver al inicio</Action>
      <a class="text-link" href="/metodologia/">
        Leer la metodología
      </a>
    </div>
  </div>
</Base>
